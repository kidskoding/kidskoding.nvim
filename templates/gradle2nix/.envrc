# keep nix glue out of the repo: local exclude, never pushed.
# nix flake init stages its files with --intent-to-add, so undo that too.
if exclude=$(git rev-parse --git-path info/exclude 2>/dev/null); then
  for f in flake.nix flake.lock .envrc default.nix gradle.lock; do
    grep -qxF "$f" "$exclude" || echo "$f" >> "$exclude"
    case "$(git status --porcelain -- "$f")" in " A "*) git reset -q -- "$f" ;; esac
  done
fi

watch_file settings.gradle* build.gradle* */build.gradle* gradle/libs.versions.toml
# path: so nix sees the git-excluded flake.nix (git+file only sees tracked files)
use flake path:.
